# P302 (docs/P302-deliver.md 6章). Copy to `.env` before `docker compose up`.

# Port the client (nginx, serving the SPA + reverse-proxying /api/) is
# published on, on the Docker host.
CLIENT_PORT=8080

# Whether the backend's session cookie requires HTTPS (server/app/routers/auth.py).
# Leave "false" for this compose file, which has no TLS termination in
# front of the client service. Set to "true" only if you add a TLS
# terminator (e.g. an external reverse proxy) in front of the client
# service - see docs/P302-deliver.md 10章.
COOKIE_SECURE=false
