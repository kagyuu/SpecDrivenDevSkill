# .env.example — docker-compose.yml で参照する環境変数の例(★P302作成★)
#
# 現状の docker-compose.yml は環境変数を直接埋め込んでいるため、本ファイルは将来的に
# 環境ごとの値を外出しする際のひな形として用意した(現時点では docker-compose.yml 内の値がそのまま使われる)。

# サーバーのSQLite DBファイルパス(コンテナ内)
DATABASE_PATH=/data/app.db

# セッションCookieのSecure属性。本番相当(TLS終端あり)では未設定のままにすること(既定 true)。
# TLSなしのローカル動作確認時のみ false を指定する。
SESSION_COOKIE_SECURE=false
