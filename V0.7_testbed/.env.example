# 会議室予約システム — 環境変数のひな形(P302)
# 使い方: `cp .env.example .env` して値を埋める。
# 対応する読み込み箇所は `server/src/meeting_room/config.py`(P003 2.2)。

# SQLiteデータベースファイルのパス(コンテナ内のパス。ボリュームのマウント先と一致させる)
DB_PATH=/app/data/app.db

# セッションの無操作タイムアウト(秒)。既定 28800 = 8時間(ADR-005)
SESSION_IDLE_SECONDS=28800

# セッションの絶対有効期限(秒)。既定 86400 = 24時間(ADR-005)
SESSION_ABSOLUTE_SECONDS=86400

# 初期管理者(有効な管理者が1人もいないときだけ作成される。P003 3.6)
INITIAL_ADMIN_ID=admin001
# ★必ず変更する★ この値のままの納品・本番投入は禁止。初回ログイン後に画面から変更する
INITIAL_ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# ホスト側に公開するポート(docker-compose.yml の app.ports)
APP_PORT=8000
